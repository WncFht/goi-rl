{
  "name": "goi-rl-research",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{md,yaml,yml,json,jsonc,mjs}\"",
    "format:check": "prettier --check \"**/*.{md,yaml,yml,json,jsonc,mjs}\"",
    "lint:md": "node scripts/lint-markdown.mjs",
    "check": "python3 scripts/run_checks.py --config scripts/checks.json --mode ci",
    "test:markdown": "node --test scripts/tests/test-markdown.mjs"
  },
  "devDependencies": {
    "git-format-staged": "4.0.2",
    "prettier": "3.9.6",
    "markdownlint": "0.41.1"
  },
  "overrides": {
    "katex": "0.19.0"
  }
}
